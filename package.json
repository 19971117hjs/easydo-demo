    "universal-analytics": "0.4.20",
    "uuid": "8.3.1",
    "v-tooltip": "2.1.2",
    "vee-validate": "2.2.15",
    "vue": "2.6.10",
    "vue-advanced-cropper": "1.11.6",
    "vue-color": "file:./vendor-deps/vue-color",
    "vue-electron": "1.0.6",
    "vue-material-design-icons": "5.1.2",
    "vue-router": "3.1.3",
    "vue-select": "3.20.2",
