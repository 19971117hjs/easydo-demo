    "probe-image-size": "7.2.3",
    "promise-queue": "2.2.5",
    "rimraf": "5.0.5",
    "semver-compare": "1.0.0",
    "sequelize": "6.3.5",
    "sharp": "file:./vendor-deps/sharp",
    "sqlite3": "file:./vendor-deps/sqlite3",
    "tesseract.js": "2.1.5",
    "threads": "1.7.0",
    "tiny-worker": "2.3.0",
    "tinymce": "7.7.2",
    "typeface-poppins": "0.0.72",
    "typeface-roboto-mono": "0.0.75",
