{
  "name": "folge-local-runtime",
  "productName": "Folge",
  "version": "1.24.2-recovery",
  "author": "Oleksii Sribnyi <hello@folge.me>",
  "private": true,
  "description": "Local recovery runtime for Folge extracted from app.asar",
  "main": "./bootstrap.js",
  "scripts": {
    "start": "electron .",
    "start:debug": "electron --inspect=9229 .",
    "manifest:sync": "node ./scripts/sync-recovered-manifest.js",
    "localize:dist": "node ./scripts/localize-dist.js",
    "package:prepare": "node ./scripts/prepare-package.js",
    "dist:mac": "npm run package:prepare && electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "22.3.18",
    "electron-builder": "^26.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "me.folge.recovery",
    "productName": "Folge",
    "asar": false,
    "directories": {
      "app": ".packaging/app",
      "output": "release"
    },
    "files": [
      "**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@electron/remote": "2.0.8",
    "@forge/api": "5.1.1",
    "@he-tree/vue": "2.7.6",
    "@notionhq/client": "2.3.0",
    "@panter/vue-i18next": "0.15.2",
    "@sentry/electron": "4.15.1",
    "@tinymce/tinymce-vue": "3.2.8",
    "@vue/composition-api": "1.7.2",
    "active-win": "file:./vendor-deps/active-win",
    "adm-zip": "0.5.9",
    "async": "3.2.0",
    "axios": "0.19.2",
    "babel-runtime": "6.26.0",
    "bootstrap": "4.4.1",
    "bootstrap-vue": "2.23.1",
    "bootstrap-vue-dialog": "0.1.0",
    "color": "3.1.2",
    "cryptr": "6.0.1",
    "dayjs": "1.11.7",
    "debug": "4.2.0",
    "delay": "4.3.0",
    "docx": "5.3.0",
    "draggable-vue-directive": "2.0.6",
    "driver.js": "0.9.8",
    "electron-app-universal-protocol-client": "file:./vendor-deps/electron-app-universal-protocol-client",
    "electron-context-menu": "0.15.2",
    "electron-debug": "3.2.0",
    "electron-devtools-installer": "2.2.4",
    "electron-log": "4.1.0",
    "electron-promise-ipc": "2.1.0",
    "electron-settings": "3.2.0",
    "electron-store": "8.0.2",
    "electron-unhandled": "3.0.1",
    "electron-util": "0.13.1",
    "electron-window-state": "5.0.3",
    "eventemitter2": "6.4.3",
    "font-scanner": "file:./vendor-deps/font-scanner",
    "form-data": "4.0.0",
    "fs-extra": "8.1.0",
    "fuzzysort": "2.0.4",
    "h2m": "0.7.0",
    "handlebars": "4.5.3",
    "history": "4.10.1",
    "html-to-pdfmake": "2.0.8",
    "html-to-text": "9.0.5",
    "i18next": "21.2.0",
    "image-to-base64": "2.1.1",
    "interactjs": "1.10.27",
    "libuiohook-node": "link:./vendor-deps/libuiohook-node",
    "lodash": "4.17.15",
    "lokijs": "1.5.8",
    "md5-file": "5.0.0",
    "mime-types": "2.1.26",
    "minimist": "1.2.5",
    "nanoid": "2.1.7",
    "node-html-parser": "2.0.1",
    "node-machine-id": "1.1.12",
    "npm-platform-dependencies": "file:./vendor-deps/npm-platform-dependencies",
    "object-assign": "4.1.1",
    "officegen": "0.6.4",
    "original-fs": "1.2.0",
    "pdfmake": "0.1.66",
