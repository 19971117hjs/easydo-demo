  "repository": {
    "type": "git",
    "url": "git://github.com/mapbox/node-sqlite3.git"
  },
  "dependencies": {
    "node-addon-api": "2.0.0",
    "node-pre-gyp": "^0.11.0"
  },
  "devDependencies": {
    "@mapbox/cloudfriend": "^1.9.0",
    "aws-sdk": "2.x",
    "eslint": "3.5.0",
    "mocha": "^5.2.0"
  },
  "peerDependencies": {
    "node-gyp": "3.x"
  },
  "peerDependenciesMeta": {
    "node-gyp": {
      "optional": true
    }
  },
